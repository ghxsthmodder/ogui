<?xml version="1.0"?>
<!-- layout_game.xml : recria o menu principal do jogo "South American
     Farming" (tests/gui/__main__.py, pyray) usando somente widgets ogui.
     Design 1228x700. Assetos em assets/ (back.png, logo.png, Anton). -->
<screen id="game">
  <!-- fonte Anton + estilos menu-on/menu-off vêm da stylesheet externa -->
  <stylesheet path="themes/game.xml"/>

  <!-- fundo fullscreen. `fit="cover"` em vez de esticar: back.png e 1672x941
       e a tela e 800x600, entao esticar apertava a foto em x (33% mais
       estreita) e o olho lia isso como imagem amassada. Cover escala os dois
       eixos pelo mesmo fator e corta o excesso nas laterais. -->
  <image source="assets/back.png" x="0" y="0" width="100%" height="100%"
         fit="cover"/>

  <!-- gradiente horizontal escuro: equivale ao draw_rectangle_gradient_h
       520px, rgba(0,0,0,170) -> transparente -->
  <panel x="0" y="0" width="520" height="100%"
         background="#000000aa" gradient="#00000000" gradientDirection="horizontal"/>

  <!-- logo 662x377 escala 0.5; contain para o dia em que a caixa nao for
       exatamente a metade do arquivo (hoje e 331x189 = 0,5 * 662x377). -->
  <image source="assets/logo.png" x="0" y="0" width="331" height="189"
         fit="contain"/>

  <!-- menu: retangulos 250x46 em x=42, y=274+58k. Fonte, tamanho e
       alinhamento vem do <style element="button"> da stylesheet; so a
       cor (selecionado dourado / demais preto) e por estilo nomeado. -->
  <button id="mi_continue" style="menu-on"  text="CONTINUE"  x="42" y="274" width="250" height="46"/>
  <button id="mi_newgame"  style="menu-off" text="NEW GAME"  x="42" y="332" width="250" height="46"/>
  <button id="mi_loadgame" style="menu-off" text="LOAD GAME" x="42" y="390" width="250" height="46"/>
  <button id="mi_settings" style="menu-off" text="SETTINGS"  x="42" y="448" width="250" height="46"/>
  <button id="mi_exit"     style="menu-off" text="EXIT"      x="42" y="506" width="250" height="46"/>

  <!-- rodape: Anton 20 branco. Uma linha so, dentro do canvas de 800x600 que
       a galeria autora -- o design original (1228x700) punha o rodape em
       y=630 e o aviso da direita em x=888, os dois fora da tela em qualquer
       host de 800x600. -->
  <label text="EARLY DEVELOPMENT BUILD" font="anton" fontSize="20" color="#ffffff"
         x="40" y="556" width="260" height="24"/>
  <label text="V0.1.0.0" font="anton" fontSize="20" color="#ffffff"
         x="304" y="556" width="116" height="24"/>
  <label text="WORK IN PROGRESS" font="anton" fontSize="20" color="#ffffff"
         align="right" x="420" y="556" width="340" height="24"/>
</screen>
