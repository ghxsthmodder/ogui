<screen id="widgets">
  <panel id="bg" x="0" y="0" w="100%" h="100%" bg="#161616"/>
  <label id="lbl_title" x="1.25%" y="52" w="97.5%" h="20"
         text="Novos widgets em um grid 2 colunas (1fr 1fr)"
         font sans 16 color="#66ee66"/>

  <grid id="gd_main" x="1.25%" y="84" w="97.5%" h="70%" cols="1fr 1fr" gap="10">

    <!-- celula 1: form -->
    <panel x="0" y="0" w="100%" h="220" bg="#1c1d22" border="#3a3b44" radius="6">
      <label x="10" y="8" w="90%" h="18" text="Formulario" font sans 14 color="#aaaaaa"/>
      <searchinput id="se_busca" x="10" y="32" w="62%" h="30"
                   placeholder="Buscar..." bg="#111111"/>
      <spinner id="sp_load" x="66%" y="34" w="32%" h="26" text="filtro" speed="6"/>
      <badge id="bg_pbr" x="10" y="72" w="110" h="24" text="Shader: PBR" removable="true"/>
      <badge id="bg_inst" x="128" y="72" w="96" h="24" text="Instancing" count="4"
             removable="true" bg="#25344d" border="#3c5a86"/>
      <badge id="bg_shadow" x="232" y="72" w="110" h="24" text="ShadowMaps" count="2"
             removable="true" bg="#3a2544" border="#6c4a86"/>
      <separator x="10" y="108" w="95%" h="6"/>
      <label x="10" y="122" w="90%" h="18" text="Progresso indeterminado" font sans 12 color="#999999"/>
      <progress id="pr_ind" x="10" y="144" w="95%" h="18" indeterminate="true"
                color="#4488ff" bg="#101010" radius="4"/>
      <label x="10" y="174" w="90%" h="18" text="Determinado 60%" font sans 12 color="#999999"/>
      <progress id="pr_det" x="10" y="196" w="95%" h="18" value="0.6"
                color="#44dd88" bg="#101010" radius="4"/>
    </panel>

    <!-- celula 2: accordion -->
    <panel x="0" y="0" w="100%" h="220" bg="#1c1d22" border="#3a3b44" radius="6">
      <label x="10" y="8" w="90%" h="18" text="Accordion" font sans 14 color="#aaaaaa"/>
      <accordion id="ac_demo" x="10" y="32" w="95%" h="180" gap="4">
        <section header="Transformacoes de Cena" expanded="true">
          <label x="16" y="4" w="90%" h="18" text="Translation: X=0.0  Y=2.5  Z=0.0" font sans 12/>
          <label x="16" y="4" w="90%" h="18" text="Scale: 1.0, 1.0, 1.0" font sans 12/>
        </section>
        <section header="Rasterizacao e Shaders">
          <label x="16" y="4" w="90%" h="18" text="Cull Face: GL_BACK" font sans 12/>
          <label x="16" y="4" w="90%" h="18" text="Depth Test: GL_LESS" font sans 12/>
        </section>
        <section header="Spinners">
          <spinner x="16" y="2" w="180" h="22" variant="glyph" speed="10"/>
          <spinner x="16" y="2" w="220" h="22" text="texturas" variant="blocks" speed="7"/>
        </section>
      </accordion>
    </panel>

    <!-- celula 3: sparkline -->
    <panel x="0" y="0" w="100%" h="160" bg="#1c1d22" border="#3a3b44" radius="6">
      <label x="10" y="8" w="90%" h="18" text="Plot / Sparkline" font sans 14 color="#aaaaaa"/>
      <sparkline id="sp_fps" x="10" y="32" w="95%" h="112" label="FPS:"
                 values="58;60;59;61;57;60;62;58;59;60;55;60;61;59;60;62;63;58;52;60"
                 color="#44dd88"/>
    </panel>

    <!-- celula 4: modal trigger -->
    <panel x="0" y="0" w="100%" h="160" bg="#1c1d22" border="#3a3b44" radius="6">
      <label x="10" y="8" w="90%" h="18" text="Modal / Toast" font sans 14 color="#aaaaaa"/>
      <label x="10" y="34" w="95%" h="34" wrap="true" font sans 12 color="#999999"
             text="Modal de confirmacao e banners de notificacao (toast) expiram em 3.5s."/>
      <button id="btn_modal" x="10" y="96" w="150" h="30" text="Abrir modal"
              bg="#4488ff" color="#ffffff" radius="6"/>
      <button id="btn_toast" x="170" y="96" w="150" h="30" text="Toast info"
              bg="#2f3340" color="#dddddd" radius="6"/>
    </panel>
  </grid>

  <!-- modal de confirmacao (por ultimo: cobre a tela quando aberto) -->
  <modal id="md_confirm" x="0" y="0" w="100%" h="100%" title="Confirmação"
         open="false" panelw="320" panelh="170">
    <label x="24" y="34" w="80%" h="40" wrap="true" font sans 13
           text="Deseja regrava os shaders compilados antes de fechar o editor?"/>
    <button id="btn_cancel" x="40" y="112" w="110" h="30" text="Cancelar"
            bg="#2f3340" color="#dddddd" radius="6"/>
    <button id="btn_ok" x="180" y="112" w="110" h="30" text="Confirmar"
            bg="#4488ff" color="#ffffff" radius="6"/>
  </modal>
</screen>
