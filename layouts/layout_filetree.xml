<screen id="filetree">
  <panel id="bg" x="0" y="0" width="100%" height="100%" background="@screen"/>
  <label id="lbl_title" x="1.25%" y="52" width="97.5%" height="20"
         text="Arvore de arquivos: icones, checkboxes e linhas-guia"
         font sans 16 color="#66ee66"/>

  <label x="1.25%" y="84" width="45%" height="18" text="Diretorio real (dir=.): pastas carregam ao expandir"
         font sans 12 color="@dim"/>
  <tree id="tr_disk" x="1.25%" y="110" width="45%" height="72%" auto_height="false"
        row_height="24" icons="true" guides="true"
        background="@window" border="@border" dir=".">
  </tree>

  <label id="lbl_tree" x="48.75%" y="84" width="50%" height="18" text="2 itens marcados"
         font sans 12 color="@dim"/>
  <tree id="tr_files" x="48.75%" y="110" width="50%" height="72%" auto_height="false"
        row_height="24" icons="true" checks="true" guides="true"
        background="@window" border="@accent" bind="tree_change">
    <treeitem label="temp_test_backup" folder="true" expanded="true">
      <treeitem label="ProjTest1.sln" file="true" checked="true"/>
      <treeitem label="ProjTest3.zip" file="true"/>
      <treeitem label="DisplayDirectoryTreeview" folder="true" expanded="true">
        <treeitem label="LoadDirectoryPrev.cs" file="true" checked="true"/>
        <treeitem label="ProjTest1.csproj" file="true"/>
        <treeitem label="source.extension.vsixmanifest" file="true"/>
      </treeitem>
      <treeitem label="bin" folder="true"/>
      <treeitem label="obj" folder="true"/>
    </treeitem>
    <treeitem label="docs" folder="true" expanded="true">
      <treeitem label="file-tree-view.png" file="true"/>
      <treeitem label="README.md" file="true"/>
    </treeitem>
  </tree>
</screen>
