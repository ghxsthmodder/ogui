<screen id="data">
  <panel id="bg" x="0" y="0" width="100%" height="100%" background="@screen"/>
  <label id="lbl_group" x="1.25%" y="52" width="97.5%" height="20" text="Dados: tabela ordenavel, editavel e com marquee"
         font sans 16 color="#66ee66"/>
  <label x="1.25%" y="78" width="97.5%" height="18"
         text="Ordene clicando no cabecalho; arraste a borda de uma coluna para redimensionar; clique numa celula editavel (ou F2) para editar."/>

  <table id="tb_people" x="1.25%" y="104" width="97.5%" height="60%" row_height="22" header_height="24"
         selected="0" background="@window" color="@text" border="@accent" highlight="#334455"
         header_background="#1c2733">
    <th label="Nome" width="160" editable="true"/>
    <th label="Idade" width="80" resizable="true" scrollingText="automatic"/>
    <th label="Cidade" width="140"/>
    <th label="cpf" width="150"/>
    <th label="email" width="180" scrollingText="automatic"/>
    <th label="estado civil"/>
    <tr resizable="true" editableCells="Nome;Cidade;email" scrollingText="automatic"
        cells="Zoe;30;Rio de Janeiro;000.000.000-00;usermail@myemail.com;solteiro(a)"/>
    <tr resizable="true" editableCells="Nome;Cidade;email" scrollingText="automatic"
        cells="Ana;25;Sao Paulo;111.111.111-11;ana@example.com;casado(a)"/>
    <tr>
      <cell editable="true" scrollingText="automatic">Bob</cell>
      <cell scrollingText="automatic">9</cell>
      <cell editable="true" scrollingText="automatic">Curitiba</cell>
      <cell scrollingText="automatic">222.222.222-22</cell>
      <cell editable="true" scrollingText="automatic">bob@example.com.br</cell>
      <cell scrollingText="automatic">viuvo(a)</cell>
    </tr>
    <tr cells="Carla;41;Porto Alegre;333.333.333-33;carla@mail.com;divorciado(a)"/>
    <tr cells="Diego;19;Belo Horizonte;444.444.444-44;diego@site.org;solteiro(a)"/>
  </table>
</screen>
