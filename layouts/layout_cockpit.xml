<?xml version="1.0"?>
<!-- layout_cockpit.xml : a South American Farming driving HUD built from the
     vehicle widgets. It is authored for the gallery's 800x600 canvas -- the
     wheel turns under the pointer (or Left/Right), the
     pedals travel while held, and a Lua chunk integrates a speed out of the
     two pedals and feeds it to the speedometer -- so every control here is
     wired the way a host would wire it, through the property registry. -->
<screen id="cockpit">
  <!-- a mesma fonte/marca da tela Game, para o HUD parecer o mesmo jogo -->
  <stylesheet path="themes/game.xml"/>

  <panel x="0" y="0" width="100%" height="100%" background="#10140f"/>

  <!-- barra de contexto: cultura, fazenda e hora. Tudo comeca em y=52 porque
       a galeria injeta a barra de navegacao nos primeiros 52px. -->
  <panel x="0" y="52" width="100%" height="44" background="#1b211a"/>
  <label text="SOUTH AMERICAN FARMING" x="20" y="63" width="340" height="24"
         font="anton" fontSize="16" color="#e8d9a8"/>
  <label id="crop" text="SOJA - TALHAO 07" x="372" y="64" width="260" height="22"
         color="#9fb08f"/>
  <label id="clock" text="06:40" align="right" x="660" y="64" width="120" height="22"
         color="#e8d9a8"/>

  <!-- velocimetro: 0..60 km/h, zona vermelha acima de 45 -->
  <speedometer id="speedo" x="24" y="104" width="250" height="250"
               min="0" max="60" value="0" redline="45"
               unit="km/h" label="VELOCIDADE"
               background="#151a15" needlecolor="#e0612a" tickcolor="#c9cdc0"
               font="anton" fontSize="30"
               tooltip="Velocidade do trator (km/h)"/>

  <!-- implementos engatados -->
  <panel x="24" y="366" width="250" height="186" background="#161b16"
         border="#2c3a2c" borderWidth="1" radius="8"/>
  <label text="IMPLEMENTOS" x="38" y="374" width="200" height="20"
         fontSize="13" color="#c49b3c"/>
  <checkbox id="impl_planter" text="Plantadeira 24 linhas" checked="true"
            x="38" y="398" width="222" height="26"/>
  <checkbox id="impl_harrow" text="Grade niveladora" x="38" y="428" width="222" height="26"/>
  <checkbox id="impl_sprayer" text="Pulverizador 2000 L" checked="true"
            x="38" y="458" width="222" height="26"/>
  <separator x="38" y="490" width="222" height="1"/>
  <label text="PESO NO ENGATE" x="38" y="496" width="180" height="18"
         fontSize="12" color="#7f8c76"/>
  <progress id="weight" value="0.42" x="38" y="516" width="222" height="14"/>
  <label id="heading" text="EM LINHA RETA" x="38" y="534" width="222" height="18"
         fontSize="12" color="#9fb08f"/>

  <!-- volante: 220 graus para cada lado -->
  <steeringwheel id="steer" x="300" y="120" width="300" height="300"
                 maxangle="220" label="VOLANTE"
                 rimcolor="#1f231d" hubcolor="#3a4034" spokecolor="#9aa28e"
                 font="anton" color="#d8d2bd" fontSize="14"
                 tooltip="Arraste o volante para estercar"/>

  <!-- pedais: freio a esquerda, acelerador a direita -->
  <pedal id="brake" x="636" y="372" width="70" height="180" label="FREIO"
         background="#1c1313" platecolor="#3d2b2b" accent="#d2503c"
         font="anton" color="#f0dede" fontSize="14" tooltip="Segure para frear"/>
  <pedal id="accel" x="716" y="372" width="70" height="180" label="ACELERADOR"
         background="#121a12" platecolor="#2e3c2b" accent="#67c04a"
         font="anton" color="#e2efdc" fontSize="14" tooltip="Segure para acelerar"/>

  <!-- painel do motor -->
  <panel x="628" y="104" width="156" height="250" background="#161b16"
         border="#2c3a2c" borderWidth="1" radius="8"/>
  <label text="MARCHA" x="640" y="114" width="130" height="18"
         fontSize="12" color="#7f8c76"/>
  <label id="gear" text="N" x="640" y="132" width="130" height="58"
         font="anton" fontSize="46" color="#e8d9a8"/>
  <label text="MOTOR" x="640" y="192" width="120" height="18"
         fontSize="12" color="#7f8c76"/>
  <label id="rpm" text="850 rpm" x="640" y="210" width="130" height="24"
         font="anton" fontSize="20" color="#c9cdc0"/>
  <separator x="640" y="244" width="130" height="1"/>
  <label text="COMBUSTIVEL" x="640" y="254" width="130" height="18"
         fontSize="12" color="#7f8c76"/>
  <progress id="fuel" value="0.72" color="#c49b3c" x="640" y="278" width="130" height="14"/>
  <label text="Fazenda Santa Rita" x="640" y="300" width="130" height="20"
         color="#9fb08f"/>
  <label text="Cascavel - PR" x="640" y="322" width="130" height="18"
         fontSize="12" color="#7f8c76"/>

  <!-- rodape -->
  <statusbar x="0" y="562" width="100%" height="38" background="#1b211a"
             left="TALHAO 07 - SOJA" center="SAFRA 2026/27"
             right="Arraste o volante - segure os pedais" size="13"/>

  <script>
speed = 0

-- As faixas sao fracoes do fundo de escala, para uma mudanca de `max` no
-- XML nao deixar a quarta marcha entrando em 38 de 200.
local function gearFor(v, vmax)
  local k = vmax / 60
  if v < 0.5 * k then return "N" end
  if v < 12 * k then return "1" end
  if v < 24 * k then return "2" end
  if v < 38 * k then return "3" end
  return "4"
end

function ogui_on_load()
  ogui.set("speedo", "value", 0)
end

function ogui_on_update(t, dt)
  local acc   = tonumber(ogui.get("accel", "value")) or 0
  local brake = tonumber(ogui.get("brake", "value")) or 0

  -- O teto vem do proprio mostrador: com max="120" o ponteiro vai ate 120
  -- em vez de parar no 60 que o script tinha fixo. Aceleracao e atrito
  -- acompanham a mesma escala, entao o velocimetro leva o mesmo tempo para
  -- cruzar o mostrador qualquer que seja o fundo de escala.
  local vmax = tonumber(ogui.get("speedo", "max")) or 60
  if vmax <= 0 then vmax = 60 end
  local k = vmax / 60

  -- modelo longitudinal minimo: acelerador vence o atrito e o freio
  speed = speed + (acc * 11.0 - brake * 18.0 - 0.8) * k * dt
  speed = math.max(0, math.min(vmax, speed))
  ogui.set("speedo", "value", string.format("%.1f", speed))

  ogui.set("gear", "text", gearFor(speed, vmax))
  -- math.floor: speed is fractional, and Lua 5.3's %d rejects a number that
  -- has no integer representation (it used to depend on the speed happening
  -- to land on a whole number, which the wider dial made rare).
  ogui.set("rpm", "text", string.format("%d rpm", math.floor(850 + acc * 1550 + (speed % 12) * 30)))

  local wheel = tonumber(ogui.get("steer", "angle")) or 0
  if wheel < -5 then
    ogui.set("heading", "text", "VIRANDO A ESQUERDA")
  elseif wheel > 5 then
    ogui.set("heading", "text", "VIRANDO A DIREITA")
  else
    ogui.set("heading", "text", "EM LINHA RETA")
  end
end
  </script>
</screen>
