<?xml version="1.0"?>
<!-- layout_cockpit.xml : a South American Farming driving HUD built from the
     vehicle widgets. The wheel turns under the pointer (or Left/Right), the
     pedals travel while held, and a Lua chunk integrates a speed out of the
     two pedals and feeds it to the speedometer -- so every control here is
     wired the way a host would wire it, through the property registry. -->
<screen id="cockpit">
  <!-- a mesma fonte/marca da tela Game, para o HUD parecer o mesmo jogo -->
  <stylesheet path="themes/game.xml"/>

  <panel x="0" y="0" width="100%" height="100%" background="#10140f"/>

  <!-- barra de contexto: cultura, fazenda e hora -->
  <panel x="0" y="0" width="100%" height="48" background="#1b211a"/>
  <label text="SOUTH AMERICAN FARMING" x="20" y="11" width="340" height="26"
         font="anton" fontSize="18" color="#e8d9a8"/>
  <label id="crop" text="SOJA - TALHAO 07" x="372" y="14" width="260" height="22"
         color="#9fb08f"/>
  <label id="clock" text="06:40" align="right" x="1088" y="14" width="120" height="22"
         color="#e8d9a8"/>

  <!-- velocimetro: 0..60 km/h, zona vermelha acima de 45 -->
  <speedometer id="speedo" x="34" y="78" width="290" height="290"
               min="0" max="60" value="0" redline="45"
               unit="km/h" label="VELOCIDADE"
               background="#151a15" needlecolor="#e0612a" tickcolor="#c9cdc0"
               font="anton" fontSize="34"
               tooltip="Velocidade do trator (km/h)"/>

  <!-- implementos engatados -->
  <panel x="34" y="392" width="290" height="240" background="#161b16"
         border="#2c3a2c" borderWidth="1" radius="8"/>
  <label text="IMPLEMENTOS" x="52" y="406" width="200" height="22"
         fontSize="14" color="#c49b3c"/>
  <checkbox id="impl_planter" text="Plantadeira 24 linhas" checked="true"
            x="52" y="438" width="250" height="26"/>
  <checkbox id="impl_harrow" text="Grade niveladora" x="52" y="472" width="250" height="26"/>
  <checkbox id="impl_sprayer" text="Pulverizador 2000 L" checked="true"
            x="52" y="506" width="250" height="26"/>
  <separator x="52" y="548" width="254" height="1"/>
  <label text="PESO NO ENGATE" x="52" y="562" width="180" height="20"
         fontSize="12" color="#7f8c76"/>
  <progress id="weight" value="0.42" x="52" y="590" width="254" height="14"/>
  <label id="heading" text="EM LINHA RETA" x="52" y="612" width="254" height="20"
         fontSize="12" color="#9fb08f"/>

  <!-- volante: 220 graus para cada lado -->
  <steeringwheel id="steer" x="362" y="296" width="330" height="330"
                 maxangle="220" label="VOLANTE"
                 rimcolor="#1f231d" hubcolor="#3a4034" spokecolor="#9aa28e"
                 font="anton" color="#d8d2bd" fontSize="14"
                 tooltip="Arraste o volante para estercar"/>

  <!-- pedais: freio a esquerda, acelerador a direita -->
  <pedal id="brake" x="742" y="386" width="104" height="230" label="FREIO"
         background="#1c1313" platecolor="#3d2b2b" accent="#d2503c"
         font="anton" color="#f0dede" fontSize="14" tooltip="Segure para frear"/>
  <pedal id="accel" x="866" y="386" width="104" height="230" label="ACELERADOR"
         background="#121a12" platecolor="#2e3c2b" accent="#67c04a"
         font="anton" color="#e2efdc" fontSize="14" tooltip="Segure para acelerar"/>

  <!-- painel do motor -->
  <panel x="1002" y="78" width="192" height="290" background="#161b16"
         border="#2c3a2c" borderWidth="1" radius="8"/>
  <label text="MARCHA" x="1018" y="92" width="120" height="20"
         fontSize="12" color="#7f8c76"/>
  <label id="gear" text="N" x="1018" y="112" width="160" height="64"
         font="anton" fontSize="52" color="#e8d9a8"/>
  <label text="MOTOR" x="1018" y="190" width="120" height="20"
         fontSize="12" color="#7f8c76"/>
  <label id="rpm" text="850 rpm" x="1018" y="210" width="160" height="24"
         font="anton" fontSize="20" color="#c9cdc0"/>
  <separator x="1018" y="246" width="160" height="1"/>
  <label text="COMBUSTIVEL" x="1018" y="258" width="140" height="20"
         fontSize="12" color="#7f8c76"/>
  <progress id="fuel" value="0.72" color="#c49b3c" x="1018" y="284" width="160" height="14"/>
  <label text="Fazenda Santa Rita" x="1018" y="316" width="160" height="20"
         color="#9fb08f"/>
  <label text="Cascavel - PR" x="1018" y="336" width="160" height="20"
         fontSize="12" color="#7f8c76"/>

  <!-- rodape -->
  <statusbar x="0" y="656" width="100%" height="44" background="#1b211a"
             left="TALHAO 07 - SOJA" center="SAFRA 2026/27"
             right="Arraste o volante - segure os pedais" size="13"/>

  <script>
speed = 0

local function gearFor(v)
  if v < 0.5 then return "N" end
  if v < 12 then return "1" end
  if v < 24 then return "2" end
  if v < 38 then return "3" end
  return "4"
end

function ogui_on_load()
  ogui.set("speedo", "value", 0)
end

function ogui_on_update(t, dt)
  local acc   = tonumber(ogui.get("accel", "value")) or 0
  local brake = tonumber(ogui.get("brake", "value")) or 0

  -- modelo longitudinal minimo: acelerador vence o atrito e o freio
  speed = speed + (acc * 11.0 - brake * 18.0 - 0.8) * dt
  speed = math.max(0, math.min(60, speed))
  ogui.set("speedo", "value", string.format("%.1f", speed))

  ogui.set("gear", "text", gearFor(speed))
  ogui.set("rpm", "text", string.format("%d rpm", 850 + acc * 1550 + (speed % 12) * 30))

  local wheel = tonumber(ogui.get("steer", "angle")) or 0
  if wheel < -5 then
    ogui.set("heading", "text", "VIRANDO A ESQUERDA")
  elseif wheel > 5 then
    ogui.set("heading", "text", "VIRANDO A DIREITA")
  else
    ogui.set("heading", "text", "EM LINHA RETA")
  end
end
  </script>
</screen>
