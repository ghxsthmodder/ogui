<screen id="basics">
  <panel id="bg" x="0" y="0" width="100%" height="100%" background="@screen"/>
  <!-- The gallery injects a Prev/Title/Next nav bar across the top; content
       starts at y=52 so nothing hides behind it. -->
  <label id="lbl_group" x="1.25%" y="52" width="97.5%" height="20" text="Basico: controles comuns"
         font sans 16 color="#66ee66"/>

  <row id="r_btns" x="1.25%" y="82" width="92.5%" height="40">
    <button id="btn_start" onClick="onStart" text="Iniciar" x="0" y="0" width="200" height="40"
            background="@accent" color="#ffffff" radius="6" tooltip="Dispara onStart"/>
    <button id="btn_load" onClick="onLoad" text="Carregar" x="0" y="0" width="200" height="40"
            background="@borderStrong" color="#fff" radius="6" tooltip="Dispara onLoad"/>
  </row>

  <textinput id="txt_log" x="1.25%" y="130" width="92.5%" height="28"
             placeholder="Digite algo..."
             background="@window" color="@text" border="@accent" radius="6"/>
  <label id="lbl_status" x="1.25%" y="166" width="92.5%" height="20" text="Boas-vindas!"
         font sans 16 color="#66ee66"/>

  <row id="r_flags" x="1.25%" y="196" width="92.5%" height="22">
    <checkbox id="cb_demo" text="Ativado" x="0" y="0" width="120" height="22" checked="false"/>
    <radiobutton id="rb_a" text="A" x="0" y="0" width="40" height="22" group="g1" checked="true"/>
    <radiobutton id="rb_b" text="B" x="0" y="0" width="40" height="22" group="g1"/>
    <radiobutton id="rb_c" text="C" x="0" y="0" width="40" height="22" group="g1"/>
    <toggleswitch id="ts_demo" x="0" y="0" width="60" height="22" checked="true"/>
  </row>

  <separator id="sep_demo" x="1.25%" y="230" width="92.5%" height="6" thickness="1"/>

  <label id="lbl_pb" x="1.25%" y="248" width="92.5%" height="18" text="Progresso (o slider abaixo o controla)"/>
  <progress id="pb_demo" x="1.25%" y="270" width="92.5%" height="12" value="0.5" color="#66ee66" radius="5"/>
  <slider id="sl_demo" x="1.25%" y="292" width="92.5%" height="20" min="0" max="100" value="50"/>

  <label id="lbl_img_t" x="1.25%" y="316" width="92.5%" height="16"
         text="Image: ajustado (esq.), tileado (dir.)"/>
  <image id="img_demo" source="assets/checker.png" x="1.25%" y="336" width="180" height="90"
         border="@accent"/>
  <image id="img_tile" source="assets/checker.png" x="25%" y="336" width="300" height="90"
         tile="true" border="@accent"/>
  <label id="lbl_img" x="63.75%" y="336" width="35%" height="90" wrap="true"
         text="src aponta para o arquivo RGBA (PNG via stb). tile repete a textura; sem tile ela e esticada ao bounds."/>
</screen>
