<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml : the demo, as the system sees it.

     The activity is dev.ogui.android.OguiActivity, one subclass of
     android.app.NativeActivity whose whole purpose is the input connection: a
     NativeActivity has none, so the keyboard it raises has nowhere to commit
     text. The subclass adds an invisible focusable view that answers for the
     field ogui has focused, and the framework loads liboggui_app.so exactly as
     it did before: the meta-data below is what it reads, and android_main is
     still the entry point.

     hasCode is spelled out because it used to say the opposite: there is Java
     in the archive now (classes.dex, from android/src, compiled by d8), and an
     activity class named here is a class the classloader has to find.

     configChanges keeps a rotation from recreating the activity. The window is
     not replaced when it is survived: the same ANativeWindow and the same
     EGLSurface come back bigger, and only APP_CMD_WINDOW_RESIZED says so, which
     is what refreshWindowSize() is for. Without this attribute every rotation
     tears the process down, the EGL context goes with it, and the GPU's font
     atlases are rebuilt from scratch on the way back in. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.ogui.demo"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <!-- GLES 3.0 is what GlBackend compiles its shader for; a device without
         it cannot run the demo at all, so it is required rather than hoped. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <supports-screens android:anyDensity="true" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="ogui"
        android:supportsRtl="true">
        <activity
            android:name="dev.ogui.android.OguiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:label="ogui">
            <meta-data
                android:name="android.app.lib_name"
                android:value="oggui_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
